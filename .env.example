# ---- Database ----
# Use the Supabase *pooler* host for both (Dashboard → Connect). The direct
# db.<ref>.supabase.co host is IPv6-only and fails on IPv4-only networks.
# DATABASE_URL: transaction pooler, port 6543 — what the app queries through.
# DIRECT_URL:   session pooler, port 5432 — only used for schema changes.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- Supabase Storage (answer sheets live in a private bucket) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ---- Auth ----
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
SESSION_DAYS=7

# ---- Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Grading sweeper ----
# A long random string. An external cron (e.g. cron-job.org) POSTs
# /api/queue/drain every few minutes with this in an X-Drain-Secret header, so
# grading finishes even when nobody has the test open. Optional: without it the
# browser alone drives grading.
DRAIN_SECRET=
