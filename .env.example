# ---- Database ----
# Prisma talks to Postgres directly. On Vercel, use the Supabase *Transaction
# pooler* string for DATABASE_URL (Dashboard → Settings → Database): serverless
# opens a connection per invocation, and pgbouncer is what keeps that from
# exhausting Postgres. DIRECT_URL is only used for schema changes.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?connection_limit=1
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- Supabase Storage (answer sheets live in a private bucket) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ---- Auth ----
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
SESSION_DAYS=7

# ---- Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Grading queue (Inngest) ----
# Local development needs neither: run `npx inngest-cli@latest dev` alongside
# `npm run dev` and it discovers the app automatically. Set both in production
# from app.inngest.com.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
