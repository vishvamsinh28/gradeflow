SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-service-role-or-secret-key
SUPABASE_STORAGE_BUCKET=submissions
DB_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite
GRADING_CONFIDENCE_THRESHOLD=0.72
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=gradeflow-dev
